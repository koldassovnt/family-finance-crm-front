# Base URL of the Spring Boot backend. CORS allows all origins and auth is a
# bearer token, so a Vite dev server on another port needs no proxy.
VITE_API_BASE_URL=http://localhost:8080

# The image tag compose builds and runs. Not set by hand: ./deploy.ps1 copies
# it from the VERSION file. Edit it here only to roll back to an older image.
# VERSION=1.0.0
